# URL of the flight MCP server's Streamable-HTTP endpoint (ADR-0004).
# Start it with: cd mcp-server && .venv/bin/python server.py --http
FLIGHT_MCP_URL=http://127.0.0.1:8000/mcp

# Google AI Studio API key for the conversational agent (ADR-0008).
# Server-only; never sent to the browser. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini model (default below). Must be free-tier eligible.
GEMINI_MODEL=gemini-2.5-flash
